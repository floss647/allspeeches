---
/*
 * Inline coaching enquiry form. Used on the coaching landing pages (1:1,
 * corporate, schools) in place of the floating call-booking popup. Posts to
 * Formspree and redirects to /thank-you on success (which fires the enquiry
 * conversion), so a coaching lead is captured and tracked on our own domain.
 * Anchor id="enquire" so page CTAs can scroll to it.
 */
import { SITE } from '../config/site';

interface Props {
  heading?: string;
  intro?: string;
  /* Options for the "what are you interested in" select. */
  interests?: string[];
}
const {
  heading = 'Get in touch',
  intro = 'Tell me a little about what you need and I will come straight back to you, usually the same day. No obligation, just a friendly reply.',
  interests = ['One to one coaching', 'Team or corporate training', 'Schools and sixth forms', 'Not sure yet'],
} = Astro.props;

const formAction = SITE.formEndpoint;
const thankYouUrl = `${SITE.url}/thank-you`;
---
<section class="section section--tint" id="enquire">
  <div class="wrap">
    <div class="enquiry-wrap measure mx-auto">
      <h2>{heading}</h2>
      <p class="lede">{intro}</p>
      <form name="coaching-enquiry" method="POST" action={formAction} class="form enquiry-form">
        <input type="hidden" name="_next" value={thankYouUrl} />
        <input type="hidden" name="_subject" value="New coaching enquiry via allspeechesgreatandsmall.com" />
        <input type="hidden" name="form_type" value="coaching_enquiry" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label>Your name<input type="text" name="name" required /></label>
        <label>Email address<input type="email" name="email" required /></label>
        <label>Phone (optional)<input type="tel" name="phone" /></label>
        <label>What are you interested in?
          <select name="interest">
            {interests.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label>Your message<textarea name="message" rows="5" placeholder="What are you working towards? Is there a talk, presentation or event coming up?"></textarea></label>

        <!-- Populated on submit by the attribution script below. -->
        <input type="hidden" name="lead_source" value="" />
        <input type="hidden" name="landing_page" value="" />
        <input type="hidden" name="referrer" value="" />
        <input type="hidden" name="enquiry_page" value="" />
        <input type="hidden" name="gclid" value="" />

        <button class="btn btn--primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.querySelector('form.enquiry-form');
    if (!form) return;
    var src = {};
    try { src = JSON.parse(sessionStorage.getItem('asgs-attribution') || '{}'); } catch (e) {}
    var landing = src.landing || (location.pathname + location.search);
    var referrer = src.referrer || '';

    function detect(landing, referrer) {
      var q = ''; var qi = landing.indexOf('?');
      if (qi >= 0) q = landing.slice(qi + 1);
      var p = new URLSearchParams(q.toLowerCase());
      var s = (p.get('utm_source') || ''); var m = (p.get('utm_medium') || '');
      var ref = (referrer || '').toLowerCase();
      if (s.indexOf('chatgpt') >= 0 || s.indexOf('openai') >= 0 ||
          ref.indexOf('chatgpt.com') >= 0 || ref.indexOf('openai.com') >= 0)
        return 'ChatGPT Ads';
      if (p.has('gclid') || (s.indexOf('google') >= 0 && (m.indexOf('cpc') >= 0 || m.indexOf('paid') >= 0)))
        return 'Google Ads';
      if (p.has('msclkid')) return 'Microsoft Ads';
      if (p.has('fbclid') || ref.indexOf('facebook') >= 0 || ref.indexOf('instagram') >= 0) return 'Facebook / Instagram';
      if (s) return 'Campaign: ' + s + (m ? ' / ' + m : '');
      if (ref.indexOf('google.') >= 0) return 'Google (organic search)';
      if (ref.indexOf('bing.') >= 0) return 'Bing (organic search)';
      if (ref.indexOf('duckduckgo') >= 0) return 'DuckDuckGo (organic search)';
      if (ref) {
        try {
          var h = new URL(referrer).hostname.replace(/^www\./, '');
          if (h && h.indexOf('allspeechesgreatandsmall') < 0) return 'Referral: ' + h;
        } catch (e) {}
      }
      return 'Direct / unknown';
    }

    function set(name, val) { var el = form.querySelector('input[name="' + name + '"]'); if (el) el.value = val; }
    function getGclid() {
      try {
        var raw = localStorage.getItem('asgs-gclid');
        if (raw) { var obj = JSON.parse(raw); if (obj.exp > Date.now()) return obj.v; }
      } catch (e) {}
      try { return (JSON.parse(sessionStorage.getItem('asgs-attribution') || '{}').gclid || ''); } catch (e) { return ''; }
    }
    set('landing_page', landing);
    set('referrer', referrer || '(none / direct)');
    set('enquiry_page', location.pathname);
    set('lead_source', detect(landing, referrer));
    set('gclid', getGclid());

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(function (r) {
          if (r.ok) {
            try {
              sessionStorage.setItem('asgs-enquiry', '1');
              sessionStorage.setItem('asgs-enquiry-type', 'coaching');
            } catch (e) {}
            window.location.href = '/thank-you';
            return;
          }
          return r.json().then(function (d) {
            throw new Error((d && d.errors ? d.errors.map(function (x) { return x.message; }).join(', ') : '') || 'error');
          });
        })
        .catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = 'Send enquiry'; }
          alert('Sorry, your message couldn\'t be sent just then. Please try again in a moment.');
        });
    });
  })();
</script>

<style>
  .enquiry-wrap h2 { margin-bottom: 0.3em; }
  .enquiry-wrap .lede { margin-bottom: 1.4em; }
  .enquiry-form label { display: block; margin-bottom: 16px; font-weight: 500; font-size: 0.95rem; }
  .enquiry-form input, .enquiry-form select, .enquiry-form textarea { display: block; width: 100%; margin-top: 6px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font: inherit; font-size: 1rem; background: #fff; }
  .enquiry-form input:focus, .enquiry-form select:focus, .enquiry-form textarea:focus { outline: 2px solid var(--gold); border-color: var(--gold); }
  .enquiry-form button { margin-top: 8px; }
</style>
