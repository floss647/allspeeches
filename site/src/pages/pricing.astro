---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, fill } from '../config/site';
import { faqPage, type Faq as FaqType } from '../lib/schema';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';

const path = '/pricing';
const title = 'Prices | Speech Writing from £399 & Public Speaking Coaching';
const description =
  'Clear, honest pricing. Bespoke speech writing from £399, and public speaking coaching from £295, plus corporate training. See exactly what is included.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path },
];

const faqs: FaqType[] = [
  { q: 'Is £399 really the full price?', a: 'Yes, for a bespoke wedding speech, that\'s everything, including unlimited revisions. No hidden extras.' },
  { q: 'When do I pay?', a: 'Full payment up front when you book. That secures your slot and we get straight to work.' },
  { q: 'What if I need it urgently?', a: 'Last-minute speeches are often possible, tell me your date and I\'ll let you know straight away.' },
  { q: 'What if I\'m not happy?', a: 'We keep refining until you are. That\'s what unlimited revisions means.' },
];

const offer = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: 'Bespoke wedding speech',
  price: SITE.price,
  priceCurrency: SITE.priceCurrency,
  url: `${SITE.url}${path}`,
  availability: 'https://schema.org/InStock',
  seller: { '@id': `${SITE.url}/#business` },
};
const included = [
  'A 100% original speech, written from scratch around your stories',
  'A relaxed chat or simple questionnaire to gather your material',
  'A complete, polished, ready-to-deliver speech',
  'Unlimited revisions until every word feels right',
  fill('Delivery within [X] days, last-minute turnarounds available'),
  'Honest, friendly, discreet service throughout',
];
---
<Layout title={title} description={description} path={path} breadcrumbs={crumbs} schemas={[offer, faqPage(faqs)]}>
  <section class="hero center">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Pricing</p>
      <h1>Prices</h1>
      <p class="lede measure mx-auto">Clear, honest pricing for both sides of what I do: writing your speech, and coaching you to deliver it. No packages to decode, no upsells, no surprises.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap measure mx-auto">
      <p class="eyebrow center">Speech writing</p>
      <h2 class="center">A speech, written for you</h2>
      <div class="price-card mt-2">
        <p class="eyebrow">Bespoke wedding speech</p>
        <p class="price">£{SITE.price}</p>
        <p>Best man, groom, father of the bride, or maid of honour. Everything included:</p>
        <ul class="ticks">{included.map((i) => <li>{i}</li>)}</ul>
        <a class="btn btn--primary" href="/contact" data-open-booking="">Book a call</a>
      </div>

      <div class="grid grid--2 mt-2">
        <div class="card"><div class="card__body">
          <h3>Eulogy writing, £399</h3>
          <p>A eulogy is also £399, the same flat price, written with the same care and no rush.</p>
          <a class="card__link" href="/eulogy-writing-service">Eulogy Writing Service →</a>
        </div></div>
        <div class="card"><div class="card__body">
          <h3>After-dinner, from £499</h3>
          <p>Longer and more involved than a wedding speech. Bespoke after-dinner speeches start from £499.</p>
          <a class="card__link" href="/after-dinner-speeches/">After-Dinner Speech Writer →</a>
        </div></div>
      </div>
    </div>
  </section>

  <section class="section section--tint center">
    <div class="wrap">
      <p class="eyebrow">Public speaking coaching</p>
      <h2>Or learn to deliver it yourself</h2>
      <p class="lede measure mx-auto">One to one coaching and corporate training, priced simply. Starting points below; the right fit is agreed on a short call.</p>
      <div class="grid grid--3 mt-2 coach-grid">
        <div class="coach-card">
          <p class="eyebrow">1:1 Public Speaking Coaching</p>
          <p class="coach-price" data-usd="$395">from £295</p>
          <p class="coach-unit">per session</p>
          <p>Beat the nerves and speak with confidence, for any talk, pitch or presentation.</p>
          <a class="btn btn--primary" href="/speech-coaching">See coaching options →</a>
        </div>
        <div class="coach-card">
          <p class="eyebrow">Wedding &amp; Occasion Coaching</p>
          <p class="coach-price" data-usd="$395">from £295</p>
          <p class="coach-unit">per session</p>
          <p>Best man, groom, father of the bride or a eulogy. Deliver it like you mean it.</p>
          <a class="btn btn--primary" href="/wedding-speech-coaching">See occasion coaching →</a>
        </div>
        <div class="coach-card">
          <p class="eyebrow">Corporate &amp; Executive Training</p>
          <p class="coach-price" data-usd="$3,400">from £2,500</p>
          <p class="coach-unit">per training day</p>
          <p>In house workshops, leadership programmes and one to one coaching for your team.</p>
          <a class="btn btn--primary" href="/executive-speaking-coaching">See corporate training →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h2>Trusted by hundreds of speakers</h2>
      <ReviewsCarousel />
    </div>
  </section>

  <Faq faqs={faqs} heading="Pricing questions" />
  <CtaBand />
</Layout>

<style>
  .price-card { background: #fff; border: 2px solid var(--gold); border-radius: var(--radius); padding: 36px; box-shadow: var(--shadow); text-align: center; }
  .price-card .ticks { text-align: left; max-width: 420px; margin-inline: auto; }
  .price { font-family: var(--serif); font-size: 4rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.4em; }
  .coach-grid { text-align: left; }
  .coach-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 26px; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .coach-price { font-family: var(--serif); font-size: 2.2rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.05em; }
  .coach-unit { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 12px; }
  .coach-card p:not(.eyebrow):not(.coach-price):not(.coach-unit) { margin-bottom: 20px; }
  .coach-card .btn { margin-top: auto; align-self: stretch; text-align: center; }
</style>

<script is:inline>
  /* Show one price, geolocated by TIME ZONE: GBP by default, USD only for
     visitors whose time zone is in the US. Not based on browser language,
     since many UK users have their language set to US English. */
  (function () {
    try {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usZones = ['America/New_York','America/Detroit','America/Kentucky','America/Indiana','America/Chicago','America/Menominee','America/Denver','America/Boise','America/Phoenix','America/Los_Angeles','America/Anchorage','America/Juneau','America/Sitka','America/Nome','America/Adak','America/Metlakatla','Pacific/Honolulu'];
      var isUS = false;
      for (var i = 0; i < usZones.length && !isUS; i++) { if (tz.indexOf(usZones[i]) === 0) isUS = true; }
      if (isUS) {
        var els = document.querySelectorAll('[data-usd]');
        for (var j = 0; j < els.length; j++) {
          var u = els[j].getAttribute('data-usd');
          if (u) els[j].textContent = u;
        }
      }
    } catch (e) {}
  })();
</script>
