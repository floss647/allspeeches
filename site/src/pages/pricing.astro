---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site';
import { faqPage, type Faq as FaqType } from '../lib/schema';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';

const path = '/pricing';
const title = 'Prices | Speech Writing from £399 & Public Speaking Coaching';
const description =
  'Clear, honest pricing. Bespoke speech writing from £399, and public speaking coaching from £295, plus corporate training. See exactly what is included.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path },
];

const faqs: FaqType[] = [
  { q: 'Is £399 really the full price?', a: 'Yes, for a bespoke wedding speech, that\'s everything, including unlimited revisions. No hidden extras.' },
  { q: 'When do I pay?', a: 'Full payment up front when you book. That secures your slot and we get straight to work.' },
  { q: 'What if I need it urgently?', a: 'Last-minute speeches are often possible, tell me your date and I\'ll let you know straight away.' },
  { q: 'What if I\'m not happy?', a: 'We keep refining until you are. That\'s what unlimited revisions means.' },
];

const offer = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: 'Bespoke wedding speech',
  price: SITE.price,
  priceCurrency: SITE.priceCurrency,
  url: `${SITE.url}${path}`,
  availability: 'https://schema.org/InStock',
  seller: { '@id': `${SITE.url}/#business` },
};

/* Two parallel offers, given equal weight on the page. */
const writing = [
  {
    name: 'Bespoke wedding speech',
    price: `£${SITE.price}`,
    unit: 'flat, all in',
    blurb: 'Best man, groom, father of the bride or maid of honour. Complete, polished and yours, with unlimited revisions.',
    cta: 'Book a call',
    href: '/contact',
    book: true,
  },
  {
    name: 'Eulogy writing',
    price: `£${SITE.price}`,
    unit: 'flat, all in',
    blurb: 'The same flat price, written with the same care and no rush, to honour someone properly.',
    cta: 'Eulogy writing service →',
    href: '/eulogy-writing-service',
    book: false,
  },
  {
    name: 'After-dinner speech',
    price: 'from £499',
    unit: 'bespoke',
    blurb: 'Longer and more involved than a wedding speech, crafted to land in the room.',
    cta: 'After-dinner speech writer →',
    href: '/after-dinner-speeches/',
    book: false,
  },
];

const coaching = [
  {
    name: '1:1 Public Speaking Coaching',
    price: 'from £295',
    usd: '$395',
    unit: 'per session',
    blurb: 'Beat the nerves and speak with confidence, for any talk, pitch or presentation.',
    cta: 'See coaching options →',
    href: '/speech-coaching',
  },
  {
    name: 'Wedding & Occasion Coaching',
    price: 'from £295',
    usd: '$395',
    unit: 'per session',
    blurb: 'Best man, groom, father of the bride or a eulogy. Deliver it like you mean it.',
    cta: 'See occasion coaching →',
    href: '/wedding-speech-coaching',
  },
  {
    name: 'Corporate & Executive Training',
    price: 'from £2,500',
    usd: '$3,400',
    unit: 'per training day',
    blurb: 'In house workshops, leadership programmes and one to one coaching for your team.',
    cta: 'See corporate training →',
    href: '/executive-speaking-coaching',
  },
];
---
<Layout title={title} description={description} path={path} breadcrumbs={crumbs} schemas={[offer, faqPage(faqs)]}>
  <section class="hero center">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Pricing</p>
      <h1>Prices</h1>
      <p class="lede measure mx-auto">Clear, honest pricing for both sides of what I do: writing your speech, and coaching you to deliver it. No packages to decode, no upsells, no surprises.</p>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Speech writing</p>
      <h2>A speech, written for you</h2>
      <p class="lede measure mx-auto">Bespoke and original, written from scratch around your stories. One flat price, unlimited revisions.</p>
      <div class="grid grid--3 mt-2 p-grid">
        {writing.map((t) => (
          <div class="p-card">
            <p class="eyebrow">{t.name}</p>
            <p class="p-price">{t.price}</p>
            <p class="p-unit">{t.unit}</p>
            <p class="p-blurb">{t.blurb}</p>
            <a class="btn btn--primary" href={t.href} data-open-booking={t.book ? '' : null}>{t.cta}</a>
          </div>
        ))}
      </div>
      <p class="p-note">Every speech includes unlimited revisions and delivery within {SITE.turnaround} days, with last minute turnarounds available.</p>
    </div>
  </section>

  <section class="section section--tint center">
    <div class="wrap">
      <p class="eyebrow">Public speaking coaching</p>
      <h2>Or learn to deliver it yourself</h2>
      <p class="lede measure mx-auto">One to one coaching and corporate training, priced simply. Starting points below; the right fit is agreed on a short call.</p>
      <div class="grid grid--3 mt-2 p-grid">
        {coaching.map((t) => (
          <div class="p-card">
            <p class="eyebrow">{t.name}</p>
            <p class="p-price" data-usd={t.usd}>{t.price}</p>
            <p class="p-unit">{t.unit}</p>
            <p class="p-blurb">{t.blurb}</p>
            <a class="btn btn--primary" href={t.href}>{t.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h2>Trusted by hundreds of speakers</h2>
      <ReviewsCarousel />
    </div>
  </section>

  <Faq faqs={faqs} heading="Pricing questions" />
  <CtaBand />
</Layout>

<style>
  .p-grid { text-align: left; }
  .p-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .p-price { font-family: var(--serif); font-size: 2.4rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.05em; }
  .p-unit { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 14px; }
  .p-blurb { margin: 0 0 22px; }
  .p-card .btn { margin-top: auto; align-self: stretch; text-align: center; }
  .p-note { margin-top: 22px; color: var(--ink-soft); font-size: 0.95rem; }
</style>

<script is:inline>
  /* Show one price, geolocated by TIME ZONE: GBP by default, USD only for
     visitors whose time zone is in the US. Not based on browser language,
     since many UK users have their language set to US English. */
  (function () {
    try {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usZones = ['America/New_York','America/Detroit','America/Kentucky','America/Indiana','America/Chicago','America/Menominee','America/Denver','America/Boise','America/Phoenix','America/Los_Angeles','America/Anchorage','America/Juneau','America/Sitka','America/Nome','America/Adak','America/Metlakatla','Pacific/Honolulu'];
      var isUS = false;
      for (var i = 0; i < usZones.length && !isUS; i++) { if (tz.indexOf(usZones[i]) === 0) isUS = true; }
      if (isUS) {
        var els = document.querySelectorAll('[data-usd]');
        for (var j = 0; j < els.length; j++) {
          var u = els[j].getAttribute('data-usd');
          if (u) els[j].textContent = u;
        }
      }
    } catch (e) {}
  })();
</script>
