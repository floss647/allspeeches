---
/*
 * LANE B: Corporate & professional speakers (high end).
 * ONE price shown, geolocated: GBP by default, USD for US visitors (inline
 * script at the foot of this file swaps any [data-usd] element).
 * "From" price anchoring only; real figure quoted after the discovery call.
 * PRICES ARE PLACEHOLDERS. Edit the `programmes` array below.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FeaturedIn from '../components/FeaturedIn.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { SITE, abs } from '../config/site';
import { service, faqPage, type Faq as FaqType } from '../lib/schema';

const path = '/executive-speaking-coaching';
const title = 'Executive Speaking Coaching | Keynotes, Pitches & Presence';
const description =
  'Private public speaking coaching for executives, founders and professional speakers. Keynotes, conference talks, investor pitches and board presentations. Bespoke programmes from £2,750. Book a discovery call.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Coaching', path: '/speech-coaching' },
  { name: 'Executive Speaking', path },
];

const ratingKnown = !SITE.rating.includes('[') && !SITE.reviewCount.includes('[');

/* EDIT THESE PRICES. Shown as "from" anchors; final price quoted on the call.
   gbp shows by default; usd shows automatically for US visitors. */
const programmes = [
  {
    name: 'Executive Presence Programme',
    gbp: 'from £2,750',
    usd: 'from $3,750',
    unit: 'around five sessions across six weeks',
    blurb: 'For senior leaders and professionals who need to speak with authority, on stage, in the boardroom, or to the market.',
    items: [
      'A tailored programme built around your role and goals',
      'Message, structure and storytelling that carries weight',
      'Executive presence, voice and stagecraft',
      'Rehearsal of a specific high stakes talk, or all round skill',
    ],
    featured: true,
  },
  {
    name: 'Keynote or Pitch VIP Day',
    gbp: 'from £3,950',
    usd: 'from $5,250',
    unit: 'full day intensive',
    blurb: 'One big talk, one focused day. Ideal for a conference keynote, a TED style talk or an investor pitch that has to land.',
    items: [
      'A full day dedicated to a single high stakes talk',
      'Script and narrative worked through with you',
      'Intensive rehearsal and refinement on the spot',
      'You leave ready to deliver, not just prepared',
    ],
    featured: false,
  },
  {
    name: 'Speaker Retainer',
    gbp: 'from £1,200',
    usd: 'from $1,650',
    unit: 'per month',
    blurb: 'Ongoing coaching for professional and repeat speakers who are always preparing for the next stage.',
    items: [
      'Regular one to one sessions on a rolling basis',
      'A trusted coach on call for every major talk',
      'Priority scheduling around your commitments',
      'Continuity that compounds your skill over time',
    ],
    featured: false,
  },
];

const faqs: FaqType[] = [
  { q: 'Who do you coach?', a: 'Executives, founders, leaders, subject matter experts and professional speakers. Anyone whose role puts them in front of an audience where the stakes are real.' },
  { q: 'Why is the price given as "from"?', a: 'Every programme is tailored to the person, the talk and the goal. After a short discovery call I\'ll recommend the right approach and confirm a fixed, complete price, with no surprises.' },
  { q: 'Can you coach for a specific event, like a keynote or a pitch?', a: 'Yes. Much of my executive work is built around one high stakes talk. The VIP Day and the Presence Programme are both designed for exactly that.' },
  { q: 'Do you write the talk as well as coach it?', a: 'I can. As a professional speechwriter I can develop the script and then coach the delivery, a rare combination that makes the whole thing seamless.' },
  { q: 'Is coaching online or in person?', a: 'Online by default, which works well for busy schedules across the UK and US. In person and on site sessions are available for certain engagements.' },
  { q: 'Can you work with teams as well as individuals?', a: 'Yes. Get in touch about the team, the occasion and your goals, and I\'ll put together a tailored proposal.' },
];

/* Schema: Service with a "from" price anchor at the entry programme (GBP base). */
const schemas = [
  service({
    serviceType: 'Executive public speaking coaching',
    name: 'Executive Speaking Coaching',
    path,
    description,
    withPrice: true,
    price: '2750',
  }),
  faqPage(faqs),
];
---
<Layout title={title} description={description} path={path} breadcrumbs={crumbs} schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="media" style="align-items:center">
        <div>
          <p class="eyebrow">Executive Speaking Coaching</p>
          <h1>Command the room when it counts.</h1>
          <p class="lede">
            Private coaching for executives, founders and professional speakers. Keynotes, conference
            talks, investor pitches and board presentations, delivered with the clarity, authority
            and presence your position demands.
          </p>
          <div class="btn-row mt-2">
            <a class="btn btn--primary" href="/contact" data-open-booking="">Book a discovery call</a>
            <a class="btn btn--ghost" href="#programmes">View programmes ↓</a>
          </div>
        </div>
        <img src="/images/conference-keynote.webp" alt="A speaker on a conference keynote stage" width="520" height="400" />
      </div>
    </div>
  </section>

  <FeaturedIn />

  <section class="section">
    <div class="wrap media">
      <div>
        <h2>Where I make the difference</h2>
        <ul class="ticks">
          <li><strong>Conference keynotes and TED style talks.</strong> A message that resonates and a delivery that commands the stage.</li>
          <li><strong>Investor and sales pitches.</strong> Clarity and conviction when there's real money on the line.</li>
          <li><strong>Board and leadership presentations.</strong> Authority and composure in the room that matters most.</li>
          <li><strong>Award stages and hosting.</strong> Poise and personality when all eyes are on you.</li>
        </ul>
      </div>
      <div>
        <h2>How we'll work</h2>
        <ol class="steps">
          <li><strong>Discovery call.</strong> We discuss your role, the talk, the audience and what great looks like for you.</li>
          <li><strong>A tailored proposal.</strong> I recommend the right programme and confirm a fixed, complete price.</li>
          <li><strong>Coaching and rehearsal.</strong> One to one, refining message and delivery until you're ready to own it.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tint center" id="programmes">
    <div class="wrap">
      <p class="eyebrow">Programmes</p>
      <h2>Tailored to you</h2>
      <p class="lede measure mx-auto">A starting point for every kind of engagement. Your exact programme and price are confirmed after a discovery call.</p>
      <div class="progs mt-2">
        {programmes.map((p) => (
          <div class={`prog${p.featured ? ' prog--featured' : ''}`}>
            {p.featured && <span class="prog__badge">Most requested</span>}
            <p class="eyebrow">{p.name}</p>
            <p class="prog__price" data-usd={p.usd}>{p.gbp}</p>
            <p class="prog__unit">{p.unit}</p>
            <p class="prog__blurb">{p.blurb}</p>
            <ul class="ticks">{p.items.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn--primary" href="/contact" data-open-booking="">Book a discovery call</a>
          </div>
        ))}
      </div>
      <p class="prog__note">Coaching a team, or planning something bespoke? <a href="/contact" data-open-booking="">Tell me about it →</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap media">
      <img src="/images/Adrian-simpson.jpg" alt="Adrian Simpson, executive speaking coach" width="400" height="500" loading="lazy" />
      <div>
        <p class="eyebrow">Why work with me</p>
        <h2>A broadcaster, a writer, and your coach</h2>
        <p>
          I started as a magazine journalist, spent fifteen years in television including presenting
          on BBC Top Gear, and have written speeches professionally since 2012, making me the UK's
          most highly rated and reviewed speech writer. I've given talks around the world, including
          at MIT in Boston, to global CEOs in the telecoms industry, and I've coached others to do
          the same.
        </p>
        <p>
          For executive clients that means something rare: a coach who can help you craft the words
          <em>and</em> command the room, because I've had to do both.
        </p>
        {ratingKnown && (
          <p class="lede"><span class="stars">★★★★★</span> {SITE.rating}/5 from {SITE.reviewCount} verified reviews.</p>
        )}
        <a class="btn btn--ghost" href={SITE.founderUrlPath}>Read my story →</a>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h2>Trusted by hundreds of speakers</h2>
      <ReviewsCarousel />
    </div>
  </section>

  <Faq faqs={faqs} heading="Executive coaching questions" />

  <CtaBand
    heading="Let's talk about your next talk"
    text="Book a discovery call. Tell me about the talk, the audience and the stakes, and I'll recommend exactly how to get you there."
    ctaLabel="Book a discovery call"
    secondaryLabel="See corporate speech writing"
    secondaryHref="/corporate-speeches"
  />
</Layout>

<script is:inline>
  /* Show one price, geolocated by TIME ZONE: GBP by default, USD only for
     visitors whose time zone is in the US. Deliberately NOT based on browser
     language, since many UK users have their language set to US English. */
  (function () {
    try {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usZones = ['America/New_York','America/Detroit','America/Kentucky','America/Indiana','America/Chicago','America/Menominee','America/Denver','America/Boise','America/Phoenix','America/Los_Angeles','America/Anchorage','America/Juneau','America/Sitka','America/Nome','America/Adak','America/Metlakatla','Pacific/Honolulu'];
      var isUS = false;
      for (var i = 0; i < usZones.length && !isUS; i++) { if (tz.indexOf(usZones[i]) === 0) isUS = true; }
      if (isUS) {
        var els = document.querySelectorAll('[data-usd]');
        for (var j = 0; j < els.length; j++) {
          var u = els[j].getAttribute('data-usd');
          if (u) els[j].textContent = u;
        }
      }
    } catch (e) {}
  })();
</script>

<style>
  .progs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: left; }
  @media (max-width: 900px) { .progs { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
  .prog {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .prog--featured { border: 2px solid var(--gold); }
  .prog__badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: #fff; font: 600 0.72rem var(--sans);
    text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 12px; border-radius: 999px;
    white-space: nowrap;
  }
  .prog__price { font-family: var(--serif); font-size: 2.2rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.05em; }
  .prog__unit { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 12px; }
  .prog__blurb { font-weight: 500; margin: 0 0 12px; }
  .prog .ticks { margin-block: 4px 22px; }
  .prog .btn { margin-top: auto; align-self: stretch; text-align: center; }
  .prog__note { margin-top: 22px; color: var(--ink-soft); font-size: 0.95rem; }
</style>
