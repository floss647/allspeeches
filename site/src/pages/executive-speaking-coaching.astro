---
/*
 * CORPORATE / TEAM TRAINING (slug kept as /executive-speaking-coaching for
 * SEO + existing links). Corporate-first: in-house team workshops and
 * leadership programmes lead; 1:1 executive coaching is secondary.
 * Prices are "from" anchors, geolocated GBP/USD (script at foot). Bespoke
 * quoted after a call. PRICES ARE PLACEHOLDERS. Edit the `programmes` array.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FeaturedIn from '../components/FeaturedIn.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { SITE, abs } from '../config/site';
import { service, faqPage, type Faq as FaqType } from '../lib/schema';

const path = '/executive-speaking-coaching';
const title = 'Presentation Skills & Public Speaking Training | Teams & Executives';
const description =
  'In-house presentation skills and public speaking training for teams and leaders. Bespoke workshops, leadership programmes and 1:1 executive coaching from Adrian Simpson, a former BBC broadcaster who has coached global CEOs. Book a call.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Coaching', path: '/speech-coaching' },
  { name: 'Corporate Training', path },
];

const ratingKnown = !SITE.rating.includes('[') && !SITE.reviewCount.includes('[');

/* EDIT THESE PRICES. Shown as "from" anchors; final price quoted after a call.
   gbp shows by default; usd shows automatically for US visitors. Omit `usd`
   to leave a price unswapped (e.g. the "Tailored" programme). */
const programmes = [
  {
    name: 'In-House Team Workshop',
    gbp: 'from £2,500',
    usd: 'from $3,400',
    unit: 'per training day, for your team',
    blurb: 'A hands-on training day that lifts your whole team, built around the talks and pitches they actually give.',
    items: [
      'A full day built around your team and their real presentations',
      'Structure, delivery, presence, nerves and handling questions',
      'Delivered at your offices or online',
      'Everyone leaves with tools they can use the next morning',
    ],
    featured: true,
  },
  {
    name: 'Leadership Communication Programme',
    gbp: 'Tailored',
    unit: 'multi-session, for leaders & cohorts',
    blurb: 'A bespoke programme for leadership teams, high-potentials or a specific initiative that needs the whole group speaking well.',
    items: [
      'Several sessions across weeks, shaped to your goals',
      'Message discipline, executive presence and storytelling',
      'Built around your sector and your real high-stakes moments',
      'A clear before-and-after on the presentations that matter',
    ],
    featured: false,
  },
  {
    name: '1:1 Executive Coaching',
    gbp: 'from £2,750',
    usd: 'from $3,750',
    unit: 'for an individual senior leader',
    blurb: 'Private coaching for a single leader with a keynote, pitch or board presentation on the line.',
    items: [
      'One to one coaching around a specific talk or all-round skill',
      'Script and narrative developed and rehearsed with you',
      'Executive presence, voice and stagecraft',
      'Discreet, flexible, built around your schedule',
    ],
    featured: false,
  },
];

const faqs: FaqType[] = [
  { q: 'Who is this training for?', a: 'Teams and leaders in any organisation: sales and pitch teams, leadership groups, conference speakers, or a cohort preparing for a specific event. I also coach individual senior leaders one to one.' },
  { q: 'Is training delivered in-house or online?', a: 'Both. I run workshops at your offices anywhere in the UK, and online for distributed teams or US clients. The format is part of the proposal.' },
  { q: 'How is it priced?', a: 'In-house team days start from £2,500 and individual executive coaching from £2,750; multi-session programmes are quoted per scope. You get a fixed, itemised proposal after a short call, so there are no surprises.' },
  { q: 'How big can the group be?', a: 'Workshops work best up to around twelve people, so everyone gets hands-on practice. Larger groups can run across several sessions, or as a keynote plus breakout format.' },
  { q: 'Can you tailor it to our sector or a specific event?', a: 'Always. Every workshop is built around your people\'s real talks, pitches and presentations, in your context, never a generic script.' },
  { q: 'Do you write the talks as well as coach them?', a: 'I can. As a professional speechwriter I can develop key scripts and pitches and then coach the delivery, a rare combination most trainers can\'t offer.' },
];

/* Schema: corporate training service, "from" day-rate anchor (GBP base). */
const schemas = [
  service({
    serviceType: 'Corporate communication training',
    name: 'Corporate Public Speaking Training',
    path,
    description,
    withPrice: true,
    price: '2500',
  }),
  faqPage(faqs),
];
---
<Layout title={title} description={description} path={path} breadcrumbs={crumbs} schemas={schemas}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="media" style="align-items:center">
        <div>
          <p class="eyebrow">Corporate &amp; Executive Training</p>
          <h1>Presentation skills training for your team.</h1>
          <p class="lede">
            In-house presentation skills and public speaking training: workshops, leadership
            programmes and one to one coaching that give your people the confidence and skill to
            present, pitch and speak with authority. Delivered at your offices or online, built
            around your business.
          </p>
          <div class="btn-row mt-2">
            <a class="btn btn--primary" href="/contact" data-open-booking="">Book a call</a>
            <a class="btn btn--ghost" href="#programmes">View training options ↓</a>
          </div>
        </div>
        <img src="/images/conference-keynote.webp" alt="A speaker training a corporate audience from the stage" width="520" height="400" />
      </div>
    </div>
  </section>

  <FeaturedIn />

  <section class="section">
    <div class="wrap media">
      <div>
        <h2>Where teams need it most</h2>
        <ul class="ticks">
          <li><strong>Sales &amp; pitch teams.</strong> Win more with pitches that are clear, confident and land.</li>
          <li><strong>Leadership &amp; all-hands.</strong> Speak with the authority your people actually believe.</li>
          <li><strong>Conference &amp; keynote speakers.</strong> Represent the business brilliantly on stage.</li>
          <li><strong>Investor &amp; board presentations.</strong> Clarity and conviction when the stakes are highest.</li>
        </ul>
      </div>
      <div>
        <h2>How we'll work</h2>
        <ol class="steps">
          <li><strong>A short call.</strong> We talk through your team, the goal and the context.</li>
          <li><strong>A tailored proposal.</strong> Scope, format and a fixed price, with no surprises.</li>
          <li><strong>We deliver.</strong> At your offices or online, with practical tools people use straight away.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tint center" id="programmes">
    <div class="wrap">
      <p class="eyebrow">Training options</p>
      <h2>Presentation skills training, built around your business</h2>
      <p class="lede measure mx-auto">A starting point for every kind of engagement. Your exact scope, format and price are confirmed in a fixed proposal after a short call.</p>
      <div class="progs mt-2">
        {programmes.map((p) => (
          <div class={`prog${p.featured ? ' prog--featured' : ''}`}>
            {p.featured && <span class="prog__badge">Most requested</span>}
            <p class="eyebrow">{p.name}</p>
            <p class="prog__price" data-usd={p.usd}>{p.gbp}</p>
            <p class="prog__unit">{p.unit}</p>
            <p class="prog__blurb">{p.blurb}</p>
            <ul class="ticks">{p.items.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn--primary" href="/contact" data-open-booking="">Book a call</a>
          </div>
        ))}
      </div>
      <p class="prog__note">Something bigger or more bespoke in mind? <a href="/contact" data-open-booking="">Tell me about it →</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap media">
      <img src="/images/Adrian-simpson.jpg" alt="Adrian Simpson, corporate public speaking trainer" width="400" height="500" loading="lazy" />
      <div>
        <p class="eyebrow">Why work with me</p>
        <h2>A broadcaster, a writer, and your trainer</h2>
        <p>
          I started as a magazine journalist, spent fifteen years in television including presenting
          on BBC Top Gear, and have written speeches professionally since 2012, making me the UK's
          most highly rated and reviewed speech writer. I've given talks around the world, including
          at MIT in Boston, to global CEOs in the telecoms industry, and I train teams and leaders to
          do the same.
        </p>
        <p>
          For organisations that means something rare: a trainer who can help your people craft the
          words <em>and</em> command the room, because I've had to do both.
        </p>
        {ratingKnown && (
          <p class="lede"><span class="stars">★★★★★</span> {SITE.rating}/5 from {SITE.reviewCount} verified reviews.</p>
        )}
        <a class="btn btn--ghost" href={SITE.founderUrlPath}>Read my story →</a>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h2>Trusted by hundreds of speakers</h2>
      <ReviewsCarousel />
    </div>
  </section>

  <Faq faqs={faqs} heading="Corporate training questions" />

  <CtaBand
    heading="Let's scope your team's training"
    text="Book a call. Tell me about your team, the goal and the timing, and I'll send a tailored proposal."
    ctaLabel="Book a call"
    secondaryLabel="See corporate speech writing"
    secondaryHref="/corporate-speeches"
  />
</Layout>

<script is:inline>
  /* Show one price, geolocated by TIME ZONE: GBP by default, USD only for
     visitors whose time zone is in the US. Deliberately NOT based on browser
     language, since many UK users have their language set to US English. */
  (function () {
    try {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usZones = ['America/New_York','America/Detroit','America/Kentucky','America/Indiana','America/Chicago','America/Menominee','America/Denver','America/Boise','America/Phoenix','America/Los_Angeles','America/Anchorage','America/Juneau','America/Sitka','America/Nome','America/Adak','America/Metlakatla','Pacific/Honolulu'];
      var isUS = false;
      for (var i = 0; i < usZones.length && !isUS; i++) { if (tz.indexOf(usZones[i]) === 0) isUS = true; }
      if (isUS) {
        var els = document.querySelectorAll('[data-usd]');
        for (var j = 0; j < els.length; j++) {
          var u = els[j].getAttribute('data-usd');
          if (u) els[j].textContent = u;
        }
      }
    } catch (e) {}
  })();
</script>

<style>
  .progs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: left; }
  @media (max-width: 900px) { .progs { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
  .prog {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .prog--featured { border: 2px solid var(--gold); }
  .prog__badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: #fff; font: 600 0.72rem var(--sans);
    text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 12px; border-radius: 999px;
    white-space: nowrap;
  }
  .prog__price { font-family: var(--serif); font-size: 2.2rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.05em; }
  .prog__unit { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 12px; }
  .prog__blurb { font-weight: 500; margin: 0 0 12px; }
  .prog .ticks { margin-block: 4px 22px; }
  .prog .btn { margin-top: auto; align-self: stretch; text-align: center; }
  .prog__note { margin-top: 22px; color: var(--ink-soft); font-size: 0.95rem; }
</style>
