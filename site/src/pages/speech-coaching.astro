---
/*
 * PUBLIC SPEAKING COACHING: dedicated 1:1 landing page for individuals and
 * professionals (Google Ads destination for the "public speaking coaching"
 * campaign). Sells the offer directly; light links out to the wedding and
 * corporate pages as secondary. Prices geolocated GBP/USD (script at foot).
 * PRICES ARE PLACEHOLDERS. Edit the `tiers` array below.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FeaturedIn from '../components/FeaturedIn.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { SITE, abs } from '../config/site';
import { service, faqPage, type Faq as FaqType } from '../lib/schema';

const path = '/speech-coaching';
const title = 'Public Speaking Coaching | 1:1 with Adrian Simpson';
const description =
  'One to one public speaking coaching to beat the nerves and speak with confidence, from Adrian Simpson, a former BBC broadcaster and the UK\'s most reviewed speechwriter. Sessions from £295. Book a discovery call.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Public Speaking Coaching', path },
];

const ratingKnown = !SITE.rating.includes('[') && !SITE.reviewCount.includes('[');

/* EDIT THESE PRICES. gbp shows by default; usd shows automatically for US visitors. */
const tiers = [
  {
    name: 'Single Session',
    gbp: '£295',
    usd: '$395',
    unit: 'one 90 minute session',
    blurb: 'Perfect for a specific talk, or to test the water.',
    items: [
      'A 90 minute one to one session, online',
      'Work on a real talk or a specific skill',
      'Honest feedback and practical fixes',
      'A recording review so you can see the change',
    ],
    featured: false,
  },
  {
    name: 'Confidence Programme',
    gbp: 'from £995',
    usd: 'from $1,350',
    unit: 'four sessions',
    blurb: 'For a real, lasting shift in how you speak.',
    items: [
      'Four one to one sessions shaped around your goals',
      'From nerves and mindset to structure and delivery',
      'Rehearsal and feedback throughout',
      'The confidence to speak well in any room',
    ],
    featured: true,
  },
  {
    name: 'Big-Talk Prep',
    gbp: 'from £1,250',
    usd: 'from $1,695',
    unit: 'intensive preparation',
    blurb: 'One high stakes talk, made ready.',
    items: [
      'Focused prep for a keynote, pitch or interview',
      'Your message and script worked through with you',
      'Intensive rehearsal until it is bulletproof',
      'You walk in ready, not just prepared',
    ],
    featured: false,
  },
];

const faqs: FaqType[] = [
  { q: 'Who do you coach?', a: 'Anyone who has to speak and wants to do it better: professionals, managers, founders, people facing an interview or a big presentation, and nervous first time speakers. If standing up to speak matters to you, I can help.' },
  { q: 'I get really nervous. Can coaching still help?', a: 'Yes, that is exactly what most of my clients come for. Nerves are normal and very beatable with the right techniques and preparation. We build your confidence step by step.' },
  { q: 'Is coaching online or in person?', a: 'Online by default, so we can work together wherever you are in the UK, the US or beyond. In person sessions can be arranged on request.' },
  { q: 'How many sessions will I need?', a: 'It depends on your goal. A single session suits a specific talk; the programme is for a lasting change; big-talk prep is for one high stakes moment. We agree the right fit on your discovery call.' },
  { q: 'Can you help with a specific upcoming talk?', a: 'Absolutely. Bring the real talk, pitch or interview and we will get it ready together, from the message to the delivery.' },
  { q: 'Do you write the talk as well as coach it?', a: 'I can. As a professional speechwriter I can develop the script and then coach the delivery, a rare combination. Or explore <a href="/pricing/">speech writing on its own</a>.' },
];

const schemas = [
  service({
    serviceType: 'Public speaking coaching',
    name: 'Public Speaking Coaching',
    path,
    description,
    withPrice: true,
    price: '295',
  }),
  faqPage(faqs),
];
---
<Layout title={title} description={description} path={path} breadcrumbs={crumbs} schemas={schemas}>
  <section class="hero center">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Public Speaking Coaching</p>
      <h1>Public speaking coaching that turns dread into confidence.</h1>
      <p class="lede measure mx-auto">
        One to one coaching for anyone who has to stand up and speak, and wants to do it well. Beat
        the nerves, sharpen your message and deliver with genuine confidence, whether it's a
        presentation, a pitch or the talk of your career. Coached personally by Adrian Simpson.
      </p>
      <div class="btn-row mt-2" style="justify-content:center">
        <a class="btn btn--primary" href="/contact/" data-open-booking="">Book a discovery call</a>
        <a class="btn btn--ghost" href="#prices">See coaching options ↓</a>
      </div>
      {ratingKnown && (
        <p class="lede mt-2"><span class="stars">★★★★★</span> {SITE.rating}/5 from {SITE.reviewCount} verified reviews</p>
      )}
    </div>
  </section>

  <FeaturedIn />

  <section class="section">
    <div class="wrap media">
      <div>
        <h2>What coaching does for you</h2>
        <ul class="ticks">
          <li><strong>Calms the nerves.</strong> Practical techniques for your breath, your voice and your hands.</li>
          <li><strong>Sharpens your message.</strong> Structure and words that land, instead of ramble.</li>
          <li><strong>Fixes your delivery.</strong> Pace, pauses, presence and eye contact.</li>
          <li><strong>Builds lasting confidence.</strong> Skills you keep for every talk, not just the next one.</li>
        </ul>
      </div>
      <div>
        <h2>How it works</h2>
        <ol class="steps">
          <li><strong>Book a discovery call.</strong> A free, no obligation chat about your goal.</li>
          <li><strong>We choose the right option.</strong> A single session, a programme, or focused prep for one big talk.</li>
          <li><strong>We work one to one.</strong> Online, at your pace, until you're ready.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tint center" id="prices">
    <div class="wrap">
      <p class="eyebrow">Coaching options</p>
      <h2>Public speaking coaching options</h2>
      <p class="lede measure mx-auto">Simple, clear pricing. Prices are a starting point; tell me your goal on a short call and I'll recommend the right fit.</p>
      <div class="tiers mt-2">
        {tiers.map((t) => (
          <div class={`tier${t.featured ? ' tier--featured' : ''}`}>
            {t.featured && <span class="tier__badge">Most popular</span>}
            <p class="eyebrow">{t.name}</p>
            <p class="tier__price" data-usd={t.usd}>{t.gbp}</p>
            <p class="tier__unit">{t.unit}</p>
            <p class="tier__blurb">{t.blurb}</p>
            <ul class="ticks">{t.items.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn--primary" href="/contact/" data-open-booking="">Book a discovery call</a>
          </div>
        ))}
      </div>
      <p class="tier__note">Facing a wedding speech, or looking to train a team? See <a href="/wedding-speech-coaching/">wedding &amp; occasion coaching</a> or <a href="/executive-speaking-coaching/">corporate training</a>.</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap media">
      <img src="/images/Adrian-simpson.jpg" alt="Adrian Simpson, public speaking coach" width="400" height="500" loading="lazy" />
      <div>
        <p class="eyebrow">Why work with me</p>
        <h2>Coached by someone who's done it for real</h2>
        <p>
          I started as a magazine journalist, spent fifteen years in television including presenting
          on BBC Top Gear, and have written speeches professionally since 2012, making me the UK's
          most highly rated and reviewed speech writer. I've given talks around the world, including
          at MIT in Boston, to global CEOs in the telecoms industry, and I've helped thousands of
          people find the words that matter most.
        </p>
        <p>
          Coaching is where those two worlds meet: I help you get the words right <em>and</em> deliver
          them like you mean them.
        </p>
        {ratingKnown && (
          <p class="lede"><span class="stars">★★★★★</span> {SITE.rating}/5 from {SITE.reviewCount} verified reviews.</p>
        )}
        <a class="btn btn--ghost" href={SITE.founderUrlPath}>Read my story →</a>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h2>What people say about working with Adrian</h2>
      <ReviewsCarousel />
    </div>
  </section>

  <Faq faqs={faqs} heading="Public speaking coaching questions" />

  <CtaBand
    heading="Ready to speak with confidence?"
    text="Book a free discovery call. Tell me what you're working towards and I'll recommend the best way to get you there."
    ctaLabel="Book a discovery call"
    secondaryLabel="Read my reviews"
    secondaryHref="/reviews"
  />
</Layout>

<script is:inline>
  /* Show one price, geolocated by TIME ZONE: GBP by default, USD only for
     visitors whose time zone is in the US. Not based on browser language,
     since many UK users have their language set to US English. */
  (function () {
    try {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usZones = ['America/New_York','America/Detroit','America/Kentucky','America/Indiana','America/Chicago','America/Menominee','America/Denver','America/Boise','America/Phoenix','America/Los_Angeles','America/Anchorage','America/Juneau','America/Sitka','America/Nome','America/Adak','America/Metlakatla','Pacific/Honolulu'];
      var isUS = false;
      for (var i = 0; i < usZones.length && !isUS; i++) { if (tz.indexOf(usZones[i]) === 0) isUS = true; }
      if (isUS) {
        var els = document.querySelectorAll('[data-usd]');
        for (var j = 0; j < els.length; j++) {
          var u = els[j].getAttribute('data-usd');
          if (u) els[j].textContent = u;
        }
      }
    } catch (e) {}
  })();
</script>

<style>
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: left; }
  @media (max-width: 900px) { .tiers { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
  .tier {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .tier--featured { border: 2px solid var(--gold); }
  .tier__badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: #fff; font: 600 0.72rem var(--sans);
    text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 12px; border-radius: 999px;
    white-space: nowrap;
  }
  .tier__price { font-family: var(--serif); font-size: 2.6rem; color: var(--gold-dark); line-height: 1; margin: 0.1em 0 0.1em; }
  .tier__unit { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 12px; }
  .tier__blurb { font-weight: 500; margin: 0 0 12px; }
  .tier .ticks { margin-block: 4px 22px; }
  .tier .btn { margin-top: auto; align-self: stretch; text-align: center; }
  .tier__note { margin-top: 22px; color: var(--ink-soft); font-size: 0.95rem; }
</style>
